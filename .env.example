# Copy this file to .env. Vite reads it only when `pnpm dev` starts: restart after changing it.

# Address of the backend API (TP-BackEnd)
VITE_API_URL = http://localhost:3000

# false: log in against the real backend (normal use).
# true: fake accounts saved in the browser, for working without a backend
#       (admin@cineweb.com / admin123, viewer@cineweb.com / viewer123). Only the login is faked.
VITE_USE_MOCK_AUTH = false
